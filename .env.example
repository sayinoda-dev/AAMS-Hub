NODE_ENV=development
PORT=3000

DATABASE_URL=DATABASE_URL

SESSION_SECRET=change-me-to-a-long-random-string

# Group join codes expire after this many days
GROUP_CODE_EXPIRY_DAYS=7

# Seed defaults (optional overrides)
SEED_ADMIN_EMAIL=admin@club.local
SEED_ADMIN_PASSWORD=AdminChangeMe1!
SEED_ADMIN_NAME=Club Admin

# Master oversight (set strong values in production; not exposed in public UI)
MASTER_USERNAME=system_creator
MASTER_PASSWORD=change-this-master-password

# SMTP — required to email project codes on idea acceptance
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-club@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AAMS Science Club <your-club@gmail.com>"
