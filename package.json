{
  "name": "aams-science-club",
  "version": "1.0.0",
  "description": "School science club — ideas, news, and project groups",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:flush-news": "node db/flush-news.js",
    "db:purge-production": "node db/purge-production.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
